# ─── Domaine & Traefik ────────────────────────────────────────────────────────
DOMAIN=plantes.ryxeuf.fr
# Nom du réseau Docker externe sur lequel Traefik écoute (détecté par preflight.sh)
TRAEFIK_NETWORK=traefik_proxy
# Nom de l'entrypoint HTTPS de ta config Traefik (souvent websecure)
TRAEFIK_ENTRYPOINT=websecure
# Nom du certresolver ACME (souvent letsencrypt ou le)
TRAEFIK_CERTRESOLVER=letsencrypt
# Identifiant unique du routeur/service Traefik pour cette stack
STACK_NAME=plantes

# ─── Compte administrateur (créé au premier démarrage uniquement) ─────────────
APP_ADMIN_EMAIL=ryxeuf@gmail.com
APP_ADMIN_PASSWORD=CHANGE_ME

# ─── Application ──────────────────────────────────────────────────────────────
APP_WORKSPACE=Maison
APP_LANG=fr
APP_TIMEZONE=Europe/Paris
APP_DEBUG=false
# Nombre d'heures après lesquelles une tâche est considérée en retard
APP_OVERDUE_TASK_HOURS=10
# Jeton des endpoints /cronjob/* — généré une fois, écrit en base à l'install
# openssl rand -hex 32
APP_CRON_PW=CHANGE_ME

# ─── Base de données ──────────────────────────────────────────────────────────
DB_DATABASE=hortusfox
DB_USERNAME=hortusfox
# openssl rand -base64 24
DB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# ─── SMTP (rappels par e-mail) ────────────────────────────────────────────────
# Laisser vide si tu passes uniquement par Home Assistant pour les notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_FROMNAME=Plantes
SMTP_FROMADDRESS=plantes@ryxeuf.fr

# ─── Sauvegardes ──────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/plantes
BACKUP_KEEP_DAYS=30

# ─── Home Assistant (optionnel, étape 6) ──────────────────────────────────────
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_NOTIFY_SERVICE=notify/mobile_app_remy
